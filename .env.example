# Copy to .env.local for local development, or set these in Railway for production.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change_me
# Base URL for links in emails (password reset, verification, etc.)
DEFAULT_URI=https://sfl-mifania.up.railway.app
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="mysql://user:pass@127.0.0.1:3306/mifania?serverVersion=8.0.32&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> nelmio/cors-bundle ###
# Regex: allow local dev + production Railway domain (mobile apps do not use CORS)
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1|sfl-mifania\.up\.railway\.app)(:[0-9]+)?$'
###< nelmio/cors-bundle ###
