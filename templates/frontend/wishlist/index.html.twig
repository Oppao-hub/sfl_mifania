{% extends 'base.html.twig' %}

{% block title %}My Wishlist | Mifania{% endblock %}

{% block main_content %}
<div class="bg-white min-h-screen">

    {# Page Header #}
    <section class="pt-10 pb-6 bg-light-gray text-center border-b border-gray-200 reveal">
        <h1 class="text-2xl md:text-4xl font-black tracking-tighter text-brand uppercase">My Wishlist</h1>

        {% if not app.user %}
            <p class="text-[10px] uppercase font-black tracking-[0.2em] text-gray-400 mt-2">
                <a href="{{ path('app_login') }}" class="text-brand underline hover:text-brand-dark transition-colors">Sign in</a> to save these items permanently.
            </p>
        {% endif %}

        <div class="mt-4 flex justify-center">
            {% include 'components/frontend/breadcrumbs.html.twig' with {
                items: [
                    { name: 'Home', url: path('app_home') },
                    { name: 'Wishlist' }
                ]
            } %}
        </div>
    </section>

    <div class="max-w-[1440px] mx-auto px-6 md:px-12 py-16 lg:py-24">

        {% if products|length > 0 %}
            {# Toolbar #}
            <div class="flex justify-between items-center mb-8 pb-4 border-b border-gray-100">
                <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">
                    Showing <span class="text-brand">{{ products|length }}</span> saved items
                </p>
            </div>

            {# Product Grid #}
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
                {% for product in products %}
                    <div class="relative group">

                        {# Remove from Wishlist Button (Always Red/Filled on this page) #}
                        <div class="absolute top-3 right-3 z-10">
                            <form action="{{ path('app_wishlist_toggle', {id: product.id}) }}" method="POST">
                                <input type="hidden" name="_token" value="{{ csrf_token('wishlist' ~ product.id) }}">
                                <button type="submit" class="p-2 bg-white/90 backdrop-blur rounded-full shadow-sm hover:scale-110 transition-transform cursor-pointer" title="Remove from Wishlist">
                                    {{ ux_icon('mdi:heart', { class: 'h-4 w-4 text-brand' }) }}
                                </button>
                            </form>
                        </div>

                        {# The Reusable Product Card Component #}
                        {% include 'components/frontend/product_card.html.twig' with {
                            'image': (product.image is not empty and product.image != 'default.png')
                                ? asset('uploads/products/' ~ product.image)
                                : 'https://placehold.co/400x500?text=No+Image',
                            'category': product.subCategory ? product.subCategory.name : product.gender.value,
                            'name': product.name,
                            'price': product.price,
                            'slug': product.slug
                        } %}
                    </div>
                {% endfor %}
            </div>

        {% else %}
            {# Empty State #}
            <div class="max-w-md mx-auto text-center py-20 bg-app-bg rounded-sm border border-gray-100 reveal">
                <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-white mb-6 text-brand shadow-sm">
                    {{ ux_icon('lucide:heart', { class: 'h-8 w-8 text-gray-300' }) }}
                </div>
                <h3 class="text-2xl font-black text-brand-dark mb-2 uppercase tracking-tight">Your wishlist is empty</h3>
                <p class="text-gray-500 mb-10 text-xs font-medium uppercase tracking-widest px-8">You haven't saved any items yet. Start exploring our sustainable collection to find your favorites.</p>
                <a href="{{ path('app_shop') }}" class="inline-block text-white bg-brand px-10 py-4 rounded-sm font-black text-[10px] tracking-[0.2em] uppercase hover:bg-brand-dark transition-all shadow-md active:scale-95">
                    Explore Collection
                </a>
            </div>
        {% endif %}

    </div>
</div>
{% endblock %}
