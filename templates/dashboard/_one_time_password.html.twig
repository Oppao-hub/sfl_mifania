{% if password is defined and password %}
    <div class="rounded-2xl border-2 border-amber-400/60 bg-amber-50 p-5 mb-6" role="alert">
        <p class="text-[10px] font-black uppercase tracking-[0.25em] text-amber-800 mb-2">Temporary password (shown once)</p>
        <p class="font-mono text-lg font-bold text-brand-dark break-all select-all">{{ password }}</p>
        <p class="text-xs text-gray mt-3 leading-relaxed">
            Copy this password now and share it through a secure channel. It will not be shown again after you leave this page.
        </p>
    </div>
{% endif %}
