{% extends 'dashboard/dashboard.html.twig' %}

{% block title %}Notification Center | Mifania{% endblock %}

{% block main_content %}
<div class="animate-fadeIn space-y-8" x-data="{
    filter: 'all',
    search: '',
    get filteredNotifications() {
        return this.notifications.filter(n => {
            const matchesFilter = this.filter === 'all' || n.type === this.filter;
            const matchesSearch = n.title.toLowerCase().includes(this.search.toLowerCase()) ||
                                n.message.toLowerCase().includes(this.search.toLowerCase());
            return matchesFilter && matchesSearch;
        });
    }
}">
    {# Header Section #}
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-brand/10 text-brand rounded-2xl flex items-center justify-center border border-brand/20 shadow-sm">
                {{ ux_icon('lucide:bell', {class: 'w-6 h-6'}) }}
            </div>
            <div>
                <h1 class="text-3xl font-black text-brand-dark tracking-tighter uppercase">Registry Alerts</h1>
                <div class="flex items-center gap-2 mt-1">
                    <span class="w-1.5 h-1.5 rounded-full bg-brand animate-pulse"></span>
                    <p class="text-[10px] font-black text-brand/40 uppercase tracking-[0.2em]">Real-time system activity logs</p>
                </div>
            </div>
        </div>

        <div class="flex items-center gap-3">
             <button x-show="notifications.length > 0"
                     @click="markAllRead()"
                     class="group flex items-center gap-2 px-6 py-3 bg-white border border-border-color text-brand hover:text-white hover:bg-brand hover:border-brand rounded-2xl text-[10px] font-black uppercase tracking-widest transition-all shadow-sm cursor-pointer active:scale-95"
                     x-transition>
                {{ ux_icon('lucide:check-check', {class: 'w-4 h-4 transition-transform group-hover:scale-110'}) }}
                Mark All as Read
            </button>
        </div>
    </div>

    {# Dynamic Controls #}
    <div class="flex flex-col md:flex-row gap-4 items-center justify-between bg-white/50 backdrop-blur-md p-4 rounded-3xl border border-border-color shadow-sm">
        <div class="flex items-center gap-2 overflow-x-auto pb-2 md:pb-0 no-scrollbar w-full md:w-auto">
            <button @click="filter = 'all'"
                    :class="filter === 'all' ? 'bg-brand text-white' : 'bg-white text-gray hover:text-brand border-border-color'"
                    class="px-5 py-2.5 rounded-xl text-[10px] font-black uppercase tracking-widest transition-all border shadow-sm shrink-0">
                All Registry
            </button>
            <button @click="filter = 'order'"
                    :class="filter === 'order' ? 'bg-brand text-white' : 'bg-white text-gray hover:text-brand border-border-color'"
                    class="px-5 py-2.5 rounded-xl text-[10px] font-black uppercase tracking-widest transition-all border shadow-sm shrink-0">
                Orders
            </button>
            <button @click="filter = 'chat'"
                    :class="filter === 'chat' ? 'bg-brand text-white' : 'bg-white text-gray hover:text-brand border-border-color'"
                    class="px-5 py-2.5 rounded-xl text-[10px] font-black uppercase tracking-widest transition-all border shadow-sm shrink-0">
                Messages
            </button>
        </div>

        <div class="relative w-full md:w-64">
            <input type="text" x-model="search" placeholder="Search registry..."
                   class="w-full pl-10 pr-4 py-3 bg-white border border-border-color rounded-2xl text-[10px] font-black uppercase tracking-widest focus:border-brand/30 focus:ring-4 focus:ring-brand/10 transition-all outline-none">
            {{ ux_icon('lucide:search', {class: 'absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-gray/40'}) }}
        </div>
    </div>

    {# Main Content Container #}
    <div class="bg-white border border-border-color rounded-[2.5rem] overflow-hidden shadow-sm min-h-[60vh] flex flex-col">
        <div class="divide-y divide-border-color flex-grow flex flex-col">
            <template x-for="notif in filteredNotifications" :key="notif.id">
                <div class="group relative flex items-start gap-6 p-8 hover:bg-brand/[0.02] transition-all border-l-4 border-transparent"
                     :class="!notif.isRead ? 'bg-brand/[0.04] border-l-brand' : ''">

                    {# Icon #}
                    <div class="w-14 h-14 rounded-2xl flex items-center justify-center shrink-0 shadow-sm transition-all group-hover:scale-110 duration-300 border"
                         :class="!notif.isRead ? 'bg-brand text-white border-brand/20' : 'bg-white text-brand/40 border-border-color'">

                        <template x-if="notif.type === 'order'">{{ ux_icon('lucide:shopping-bag', {class: 'w-6 h-6'}) }}</template>
                        <template x-if="notif.type === 'chat'">{{ ux_icon('lucide:message-square', {class: 'w-6 h-6'}) }}</template>
                        <template x-if="notif.type !== 'order' && notif.type !== 'chat'">{{ ux_icon('lucide:bell', {class: 'w-6 h-6'}) }}</template>
                    </div>

                    {# Content #}
                    <div class="flex-1 min-w-0 pt-1">
                        <div class="flex items-center justify-between gap-4 mb-2">
                            <h3 class="text-sm font-black text-brand-dark uppercase tracking-tight" x-text="notif.title"></h3>
                            <span class="text-[10px] font-black text-brand/40 uppercase tracking-widest whitespace-nowrap bg-brand/5 px-3 py-1 rounded-full" x-text="formatTime(notif.createdAt)"></span>
                        </div>
                        <p class="text-sm text-brand-dark/60 leading-relaxed font-medium max-w-3xl" x-text="notif.message"></p>

                        <template x-if="notif.targetUrl && notif.targetUrl !== '#'">
                            <div class="mt-5">
                                <a :href="notif.targetUrl" class="inline-flex items-center gap-2 text-[10px] font-black text-brand hover:text-brand-dark uppercase tracking-widest transition-colors group/link">
                                    Process Activity
                                    <span class="transition-transform group-hover/link:translate-x-1">
                                        {{ ux_icon('lucide:arrow-right', {class: 'w-3.5 h-3.5'}) }}
                                    </span>
                                </a>
                            </div>
                        </template>
                    </div>

                    {# Actions #}
                    <div class="flex items-center gap-2 opacity-0 group-hover:opacity-100 transition-opacity pr-2">
                         <button @click="dismiss(notif)"
                                 class="w-10 h-10 flex items-center justify-center text-brand/20 hover:text-danger hover:bg-danger/5 rounded-xl transition-all cursor-pointer"
                                 title="Dismiss">
                            {{ ux_icon('lucide:trash-2', {class: 'w-5 h-5'}) }}
                        </button>
                    </div>
                </div>
            </template>

            {# Vertical Centered Empty State #}
            <template x-if="filteredNotifications.length === 0">
                <div class="flex-grow flex flex-col items-center justify-center p-12 md:p-20 text-center animate-fadeIn min-h-[50vh]">

                    {# Icon Wrapper with subtle background glow #}
                    <div class="relative mb-8 group">
                        <div class="absolute inset-0 bg-brand/5 rounded-full blur-xl scale-150 transition-transform duration-500 group-hover:scale-125"></div>

                        <div class="relative w-24 h-24 bg-brand/5 border border-brand/10 rounded-[2rem] flex items-center justify-center text-brand/40 shadow-inner">
                            {{ ux_icon('lucide:bell-off', {class: 'w-10 h-10'}) }}
                        </div>

                        {# Decorative badge #}
                        <div class="absolute -top-1 -right-1 w-8 h-8 bg-white border-2 border-brand/5 rounded-full flex items-center justify-center shadow-sm">
                            <span class="w-2 h-2 rounded-full bg-brand/30"></span>
                        </div>
                    </div>

                    {# Text Content #}
                    <h3 class="text-xl font-black text-brand-dark uppercase tracking-tighter">
                        <span x-show="search || filter !== 'all'">No matches found</span>
                        <span x-show="!search && filter === 'all'">System Silence</span>
                    </h3>
                    <p class="text-xs font-bold text-brand/60 uppercase tracking-[0.15em] mt-3 max-w-xs mx-auto leading-relaxed">
                        <span x-show="search || filter !== 'all'">Your search or filter returned zero results in the registry.</span>
                        <span x-show="!search && filter === 'all'">All clear! No pending alerts or logs require your attention.</span>
                    </p>

                    {# Action Button #}
                    <div class="mt-10 flex flex-col items-center gap-4">
                        <button x-show="search || filter !== 'all'"
                                @click="search = ''; filter = 'all'"
                                class="px-8 py-4 bg-white border border-brand text-brand rounded-2xl text-[10px] font-black uppercase tracking-widest hover:bg-brand hover:text-white transition-all active:scale-95 shadow-sm">
                            Clear all filters
                        </button>

                        <a href="{{ path('app_dashboard') }}"
                           class="group inline-flex items-center gap-3 px-8 py-4 bg-brand text-white rounded-2xl text-[10px] font-black uppercase tracking-widest hover:bg-brand-dark transition-all shadow-xl shadow-brand/20 active:scale-95">
                            {{ ux_icon('lucide:layout-dashboard', {class: 'w-4 h-4 opacity-80 group-hover:-translate-y-0.5 transition-transform'}) }}
                            Return to Command Hub
                        </a>
                    </div>

                </div>
            </template>
        </div>

        {# Optional Footer Info #}
        <div x-show="notifications.length > 0"
             class="px-8 py-4 bg-brand/[0.02] border-t border-border-color flex justify-between items-center"
             x-transition>
            <p class="text-[9px] font-black text-brand/30 uppercase tracking-widest">Showing latest system events</p>
            <div class="flex gap-4">
                 <span class="flex items-center gap-1.5 text-[9px] font-black text-brand/40 uppercase tracking-widest">
                    <span class="w-1 h-1 rounded-full bg-brand"></span>
                    Orders
                 </span>
                 <span class="flex items-center gap-1.5 text-[9px] font-black text-brand/40 uppercase tracking-widest">
                    <span class="w-1 h-1 rounded-full bg-brand-light"></span>
                    Registry
                 </span>
            </div>
        </div>
    </div>
</div>
{% endblock %}
