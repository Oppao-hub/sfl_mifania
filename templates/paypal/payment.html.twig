<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PayPal Payment | Mifania</title>
    <style>
        body {
            font-family: system-ui, -apple-system, sans-serif;
            margin: 0;
            padding: 24px;
            background: #f7f8f4;
            color: #2f3a22;
        }
        .card {
            max-width: 480px;
            margin: 40px auto;
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            padding: 24px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
        }
        h1 {
            font-size: 1.25rem;
            margin: 0 0 8px;
        }
        .amount {
            font-size: 1.5rem;
            font-weight: 700;
            color: #5b8e68;
            margin-bottom: 12px;
        }
        .mode {
            font-size: 0.75rem;
            color: #6b7280;
            margin-bottom: 20px;
            text-transform: uppercase;
            letter-spacing: 0.08em;
        }
        .notice {
            background: #fff7ed;
            border: 1px solid #fed7aa;
            color: #9a3412;
            padding: 12px 14px;
            border-radius: 8px;
            font-size: 0.9rem;
            line-height: 1.5;
        }
        #payment-status {
            margin-top: 16px;
            font-size: 0.9rem;
            font-weight: 600;
            line-height: 1.5;
        }
        #payment-status.error {
            color: #b91c1c;
        }
    </style>
</head>
<body>
    <div class="card">
        <h1>Pay with PayPal</h1>
        <p class="amount">Amount: ₱{{ amount|default('10.00') }}</p>
        <p class="mode">PayPal mode: {{ paypalMode|default('sandbox') }}</p>

        {% if not paypalConfigured %}
            <div class="notice">
                PayPal checkout is not configured on the server yet. Set
                <strong>PAYPAL_CLIENT_ID</strong>, <strong>PAYPAL_CLIENT_SECRET</strong>, and
                <strong>PAYPAL_MODE</strong> (<code>sandbox</code> or <code>live</code>) in Railway.
            </div>
        {% else %}
            <div id="paypal-button-container"></div>
            <div id="payment-status"></div>
        {% endif %}
    </div>

    {% if paypalConfigured %}
        <script src="https://www.paypal.com/sdk/js?client-id={{ paypalClientId|e('html_attr') }}&currency=PHP&intent=capture{% if isSandbox %}&buyer-country=PH{% endif %}"></script>
        <script>
            const statusEl = document.getElementById('payment-status');
            const orderAmount = '{{ amount|default("10.00")|e('js') }}';
            const createOrderUrl = '{{ path('paypal_create_order')|e('js') }}';
            const captureOrderUrl = '{{ path('paypal_capture_order')|e('js') }}';

            function setStatus(message, isError = false) {
                statusEl.innerText = message;
                statusEl.classList.toggle('error', isError);
            }

            async function postJson(url, payload) {
                const response = await fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                    body: JSON.stringify(payload),
                });

                let data = {};
                try {
                    data = await response.json();
                } catch (error) {
                    throw new Error('Server returned an invalid response. Check PayPal API credentials on Railway.');
                }

                if (!response.ok) {
                    const detail = data.detail ? ` (${data.detail})` : '';
                    throw new Error((data.error || 'PayPal request failed.') + detail);
                }

                return data;
            }

            paypal.Buttons({
                createOrder: async function () {
                    setStatus('Creating order...');
                    try {
                        const data = await postJson(createOrderUrl, { amount: orderAmount });
                        if (!data.id) {
                            throw new Error('PayPal order ID missing from server response.');
                        }
                        setStatus('Order created. Complete payment in the PayPal window.');
                        return data.id;
                    } catch (error) {
                        setStatus(error.message || 'Could not create PayPal order.', true);
                        throw error;
                    }
                },
                onApprove: async function (data) {
                    setStatus('Capturing payment...');
                    try {
                        await postJson(captureOrderUrl, { orderID: data.orderID });
                        setStatus('Payment completed! Return to the Mifania app and tap Confirm Order again.');
                    } catch (error) {
                        setStatus(error.message || 'Payment capture failed.', true);
                        throw error;
                    }
                },
                onCancel: function () {
                    setStatus('Payment canceled.');
                },
                onError: function (err) {
                    console.error('PayPal SDK error:', err);
                    if (!statusEl.innerText || statusEl.innerText === 'Creating order...') {
                        setStatus(
                            (err && err.message)
                                ? err.message
                                : 'PayPal could not start checkout. Use a sandbox buyer account if PAYPAL_MODE=sandbox.',
                            true,
                        );
                    }
                },
            }).render('#paypal-button-container');
        </script>
    {% endif %}
</body>
</html>
