# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
SYMFONY_DEPRECATIONS_HELPER=disabled

# Database - Use a dedicated test database
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=app_test
MYSQL_USER=app
MYSQL_PASSWORD=app
MYSQL_PORT=3306
MYSQL_HOST=127.0.0.1

DATABASE_URL="mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@${MYSQL_HOST}:${MYSQL_PORT}/${MYSQL_DATABASE}?serverVersion=8.0.32&charset=utf8mb4"

# JWT Configuration (Required for Kernel boot)
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=your_passphrase_here

# CORS & Other required vars
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
MAILER_DSN=null://null

# Placeholder values for third-party integrations
GOOGLE_CLIENT_ID=test_id
GOOGLE_CLIENT_SECRET=test_secret
PAYPAL_CLIENT_ID=test_id
