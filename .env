# /var/www/html/.env

# Safe defaults for booting up
APP_ENV=prod
APP_SECRET=ThisIsASafeDefaultSecretForBuilding

# Blank Database Variables (Railway will fill these in later)
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_PORT=3306

# The base URL structure (Notice there are no real passwords here)
DATABASE_URL="mysql://root:@mysql:3306/app?serverVersion=8.0.32&charset=utf8mb4"

# Other integrations (Leave keys blank!)
ADMIN_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=https://sandbox.paypal.com
JWT_PASSPHRASE=
MAILER_DSN=
